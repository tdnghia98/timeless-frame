generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id                 String   @id @default(uuid())
  title              String
  description        String
  theme              String?
  date               DateTime
  userEmail          String
  folderId           String
  shareUrl           String
  qrCode             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  authorRefreshToken String?
  storageProvider    String?
  uploads            Upload[]
  user               User     @relation(fields: [userEmail], references: [email])
}

model Upload {
  id           String   @id @default(uuid())
  eventId      String
  fileName     String
  fileType     String
  fileSize     Int
  fileId       String
  thumbnailUrl String?
  downloadUrl  String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  status       String
  event        Event    @relation(fields: [eventId], references: [id])
}

model User {
  email        String  @id
  name         String?
  image        String?
  provider     String?
  passwordHash String?
  Event        Event[]
}
