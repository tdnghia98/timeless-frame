# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application Settings
# For MVP we're using mock data, but these would be used in production
# MOCK_FOLDER_ID=your_mock_folder_id_here

DATABASE_URL="file:./dev.db"
# Run openssl rand -base64 32 | cut -c1-32 to generate a random key
REFRESH_TOKEN_ENCRYPTION_KEY=your_refresh_token_encryption_key_here
SMTP_HOST=
SMTP_PORT=
# set to 'true' for port 465, otherwise 'false
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# optional, defaults to SMTP_USER
SMTP_FROM=

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# optional, for custom domains
AWS_S3_BASE_URL=

GCS_BUCKET=
GCS_PROJECT_ID=
# (JSON string of your service account credentials)
GCS_CREDENTIALS= 
# optional, for custom domains or public URLs
GCS_BASE_URL=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=
AZURE_STORAGE_ACCOUNT_NAME=
# optional, for custom domains or public URLs
AZURE_BASE_URL=